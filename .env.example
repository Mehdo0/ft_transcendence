DB_PATH=/app/data/game_data.db
BACKUP_DIRECTORY=/app/backups
BACKUP_FILE_PREFIX=game_data
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=30
BACKUP_RETENTION_COUNT=14
BACKEND_IMAGE=drawmeter-backend
DOMAIN=
APP_PORT=8081
COMPOSE_PROJECT_NAME=drawmeter
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
COOKIE_SECURE=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GUEST_ACCESS_TOKEN_EXPIRE_MINUTES=1440
GUEST_USERNAME_PREFIX=Guest
GUEST_USERNAME_DIGITS=6
GUEST_GENERATION_ATTEMPTS=100
LEADERBOARD_LIMIT=10
WORD_LIST=list.txt
ROUND_DURATION=60
COUNTDOWN_DURATION=5
ROUND_COUNTDOWN_DURATION=3
ROUND_WIN_TARGET=2
ROUND_REPLAY_DURATION=8
ROUND_REPLAY_FINAL_HOLD_DURATION=3
SCORE_INCREMENT_PER_SECOND=0.5
MATCHMAKING_RANGE_STEP=50
MATCHMAKING_MAX_RANGE=600
MATCHMAKING_WAIT_PER_STEP=5
REPLAY_MAX_STROKES=128
REPLAY_MAX_POINTS=8192
REPLAY_MAX_EVENTS=1024
WS_DISCONNECT_GRACE_PERIOD=10
VITE_WS_RECONNECT_BASE_DELAY=500
VITE_WS_RECONNECT_MAX_DELAY=4000
